+def fresh(nodes: dict) -> None:
+    """A node that follows nothing yet, with these stand-in launch nodes for hashfun to register."""
+    for f in ("launches.json", "node.json", "calls.log"):
+        (fun.HOME / f).unlink(missing_ok=True)
+    (fun.ROOT / "HASHFUN").unlink(missing_ok=True)
+    (fun.HOME / "stand-ins.json").write_text(json.dumps({t: {"rpcport": n.port, "datadir": str(n.datadir)} for t, n in nodes.items()}))
+    for n in nodes.values():
+        for c in n.datadir.glob("*/.cookie"):
+            c.unlink()
+    Q.sats, Q.on_disk, Q.sent, Q.fetching = {"ord": 5 * COIN}, {"ord"}, [], False
+    fun._knows.clear()
+
