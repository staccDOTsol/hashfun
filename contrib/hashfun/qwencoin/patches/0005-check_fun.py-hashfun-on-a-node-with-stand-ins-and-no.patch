+# ---- the relay: stand-in nodes of launches, the pages' server, a follower's end
+class Peer:
+    """A stand-in for the site's node of a launch: a listener whose connections do one thing."""
+
+    def __init__(self, how: str) -> None:
+        self.how, self.got, self.sent, self.ended, self.conns = how, 0, 0, threading.Event(), 0
+        self.srv = socket.socket()
+        self.srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        self.srv.bind(("127.0.0.1", 0))
+        self.srv.listen(64)
+        self.port = self.srv.getsockname()[1]
+        self.digest = hashlib.sha256()
+        threading.Thread(target=self.accept, daemon=True).start()
+
+    def accept(self):
+        while True:
+            try:
+                c, _ = self.srv.accept()
+            except OSError:
+                return
+            self.conns += 1
+            threading.Thread(target=getattr(self, self.how), args=(c,), daemon=True).start()
+
+    def echo(self, c):
+        while True:
+            d = c.recv(65536)
+            if not d:
+                break
+            c.sendall(d)
+        c.close()
+
+    def flood(self, c):  # sends as fast as it is taken, 48 MB of a known pattern
+        block = bytes(range(256)) * 4096
+        for _ in range(48):
+            try:
+                c.sendall(block)
+            except OSError:
+                break
+            self.sent += len(block)
+        c.close()
+        self.ended.set()
+
+    def says_then_ends(self, c):  # 200,000 bytes, then it ends its sending and goes on reading
+        c.sendall(b"s" * 200_000)
+        c.shutdown(socket.SHUT_WR)
+        while True:
+            d = c.recv(65536)
+            if not d:
+                break
+            self.got += len(d)
+        c.close()
+        self.ended.set()
+
+    def hears_then_says(self, c):  # reads until the other side has ended its sending, then answers and ends
+        while True:
+            d = c.recv(65536)
+            if not d:
+                break
+            self.got += len(d)
+            self.digest.update(d)
+        c.sendall(b"t" * 70_000)
+        c.close()
+        self.ended.set()
+
+    def quiet(self, c):
+        self.got = len(c.recv(1) or b"")  # until the line is ended from the other side
+        c.close()
+        self.ended.set()
+
