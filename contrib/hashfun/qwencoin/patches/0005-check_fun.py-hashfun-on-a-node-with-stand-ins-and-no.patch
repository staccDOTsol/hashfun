+def raw_dial(port: int, ticker: str, heads: dict | None = None, upgrade: bool = True, query: str = ""):
+    """A WebSocket handshake by hand: (status line, socket)."""
+    s = socket.create_connection(("127.0.0.1", port), timeout=20)
+    key = base64.b64encode(os.urandom(16)).decode()
+    lines = [f"GET /fun/p2p/{ticker}{query} HTTP/1.1", f"Host: 127.0.0.1:{port}"] + (["Upgrade: websocket", "Connection: Upgrade", f"Sec-WebSocket-Key: {key}",
+                                                                                         "Sec-WebSocket-Version: 13"] if upgrade else [])
+    lines += [f"{k}: {v}" for k, v in (heads or {}).items()]
+    s.sendall(("\r\n".join(lines) + "\r\n\r\n").encode())
+    head = b""
+    while b"\r\n\r\n" not in head:
+        d = s.recv(1)
+        if not d:
+            break
+        head += d
+    status = head.split(b"\r\n")[0].decode()
+    if " 101" in status:
+        assert f"Sec-WebSocket-Accept: {fun.ws_accept(key)}".lower() in head.decode().lower()
+    else:  # an ordinary answer: read to its end, as a client does before it hangs up
+        n = next((int(l.split(b":")[1]) for l in head.split(b"\r\n") if l.lower().startswith(b"content-length:")), 0)
+        _ = read_all(s, n, 10) if n else b""
+    return status, s
+
+
+def read_all(s, n: int | None = None, timeout: float = 60.0) -> bytes:
+    s.settimeout(timeout)
+    out = b""
+    while n is None or len(out) < n:
+        d = s.recv(65536 if n is None else min(65536, n - len(out)))
+        if not d:
+            break
+        out += d
+    return out
+
+
+def check_relay():
+    import web
+
+    say("10 a line to a launch's node through the pages (/fun/p2p/TICKER)")
+    peers = {"ECHO": Peer("echo"), "FLOOD": Peer("flood"), "SAYS": Peer("says_then_ends"), "HEARS": Peer("hears_then_says"), "QUIET": Peer("quiet")}
+    Site.coins = {t: coin(t, 1, p2p_port=p.port) for t, p in peers.items()}
+    Site.coins["NOPORT"] = coin("NOPORT", 1, p2p_port=22)  # a port under 1024: never dialed
+    os.environ.update(FUN_SERVE="1", FUN_WEB_PORT=str(SITE.server_address[1]))
+    web.Handler.graph, web.Handler.ord_port = None, 1
+    web.P2P_PORTS.clear()
+    pages = serve(web.Handler)
+    pport = pages.server_address[1]
+    base = f"http://127.0.0.1:{pport}/fun"
+    stop = threading.Event()
+
+    def follower(ticker: str) -> int:
+        port = fun.free_port()
+        threading.Thread(target=fun.relay, args=(ticker, port, base, stop, lambda *x: None), daemon=True).start()
+        for _ in range(200):  # (a refused dial returns at once: the thread may not have bound yet on a busy machine)
+            if fun.reach("127.0.0.1", port, 0.2):
+                break
+            time.sleep(0.05)
+        return port
+
+    # bytes both ways, whole
+    data = os.urandom(3_000_000)
+    c = socket.create_connection(("127.0.0.1", follower("ECHO")))
+    got = []
+    th = threading.Thread(target=lambda: got.append(read_all(c, len(data))))
+    th.start()
+    c.sendall(data)
+    th.join(90)
+    assert got and got[0] == data, (len(got[0]) if got else None)
+    c.close()
+    say(f"    3,000,000 random bytes to a node that says them back, through a follower's port, the pages' WebSocket and on to the node: the same bytes came back")
+    # a side that does not read holds the other back
+    f = peers["FLOOD"]
+    c = socket.create_connection(("127.0.0.1", follower("FLOOD")))
+    time.sleep(4)
+    a = f.sent
+    time.sleep(3)
+    b = f.sent
+    assert a == b and b < 40 * (1 << 20), (a, b)
+    rest = read_all(c)
+    block = bytes(range(256)) * 4096
+    assert f.ended.wait(60) and len(rest) == 48 * len(block) and hashlib.sha256(rest).digest() == hashlib.sha256(block * 48).digest()
